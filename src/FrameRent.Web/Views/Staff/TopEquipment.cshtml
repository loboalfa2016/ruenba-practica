@model IEnumerable<FrameRent.Application.DTOs.Report.TopEquipmentReportDto>
@{
    ViewData["Title"] = "Top Rented Equipment Report";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 mb-1 px-2 py-0.5 rounded" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3);">
            <span class="text-warning small fw-bold">BUSINESS INTELLIGENCE REPORT</span>
        </div>
        <h2 class="fw-bold text-light mb-1">Most Rented Equipment</h2>
        <p class="text-secondary small mb-0">Ranking of gear by rental volume and generated revenue, sorted in descending order.</p>
    </div>
    <a asp-action="Rentals" class="fr-btn-outline">&larr; Back to Rentals</a>
</div>

<div class="table-responsive">
    <table class="fr-table">
        <thead>
            <tr>
                <th style="width: 70px;">Rank</th>
                <th>Equipment Name</th>
                <th>Category</th>
                <th>Total Rentals</th>
                <th>Total Revenue (incl. Penalties)</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rank = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (rank == 1)
                        {
                            <span class="badge bg-warning text-dark fw-bold px-2 py-1">#1</span>
                        }
                        else if (rank == 2)
                        {
                            <span class="badge bg-light text-dark fw-bold px-2 py-1">#2</span>
                        }
                        else if (rank == 3)
                        {
                            <span class="badge bg-secondary text-light fw-bold px-2 py-1">#3</span>
                        }
                        else
                        {
                            <span class="text-muted fw-bold ms-2">#@rank</span>
                        }
                    </td>
                    <td>
                        <div class="fw-bold text-light">@item.EquipmentName</div>
                        <div class="text-muted small" style="font-family: monospace;">@item.EquipmentId</div>
                    </td>
                    <td>
                        <span class="fr-badge-category">@item.Category</span>
                    </td>
                    <td>
                        <span class="badge-status badge-approved">@item.TotalRentals rental(s)</span>
                    </td>
                    <td>
                        <span class="fw-bold text-light">$@item.TotalRevenue.ToString("F2")</span>
                    </td>
                </tr>
                rank++;
            }
        </tbody>
    </table>
</div>
